# Retail X environment template

# 1) Create an OpenRouter account: https://openrouter.ai/
# 2) Create an API key: https://openrouter.ai/settings/keys
# 3) Copy this file to .env
# 4) Replace the placeholder below with your own key.


OPENROUTER_API_KEY=replace_with_your_openrouter_key

# Default chosen for simple course reproduction through OpenRouter.
# The model can be changed without editing the source code.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

PORT=8000
