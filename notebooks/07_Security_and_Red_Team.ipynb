    "# ---------------------------------------------------------\n",
    "# Utility helpers\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "def normalize_order_id(order_id):\n",
    "\n",
    "    raw = str(order_id).strip()\n",
    "\n",
    "    # Exact key already exists\n",
    "    if raw in orders_by_id:\n",
    "        return raw\n",
    "\n",
    "    # Try with #\n",
    "    with_hash = \"#\" + raw.lstrip(\"#\")\n",
    "\n",
    "    if with_hash in orders_by_id:\n",
    "        return with_hash\n",
    "\n",
    "    # Try without #\n",
    "    without_hash = raw.lstrip(\"#\")\n",
    "\n",
    "    if without_hash in orders_by_id:\n",
    "        return without_hash\n",
    "\n",
    "    # Return original if no match\n",
    "    return raw\n",
    "\n",
    "\n",
    "def owner_id_for_order(order_id):\n",
    "\n",
    "    order_id = normalize_order_id(\n",
    "        order_id\n",
    "    )\n",
    "\n",
    "    order = orders_by_id.get(\n",
    "        order_id\n",
    "    )\n",
    "\n",
    "    if not order:\n",
    "        return None\n",
    "\n",
    "    owner_id = order.get(\n",
    "        \"user_id\"\n",
    "    )\n",
    "\n",
    "    if owner_id is not None:\n",
    "        return str(owner_id)\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def email_for_user(user_id):\n",
    "\n",
    "    if user_id is None:\n",
    "        return None\n",
    "\n",
    "    # Exact match\n",
    "    user = users_by_id.get(\n",
    "        user_id\n",
    "    )\n",
    "\n",
    "    # String match fallback\n",
    "    if not user:\n",
    "\n",
    "        for uid, record in users_by_id.items():\n",
    "\n",
    "            if str(uid) == str(user_id):\n",
    "\n",
    "                user = record\n",
    "                break\n",
    "\n",
    "    if not user:\n",
    "        return None\n",
    "\n",
    "    return user.get(\n",
    "        \"email\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# DEBUG\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "sample_order_id = next(\n",
    "    iter(orders_by_id)\n",
    ")\n",
    "\n",
    "sample_order = orders_by_id[\n",
    "    sample_order_id\n",
    "]\n",
    "\n",
    "print(\n",
    "    \"Sample order ID:\",\n",
    "    sample_order_id\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Sample order keys:\",\n",
    "    list(sample_order.keys())\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Sample order user_id:\",\n",
    "    sample_order.get(\"user_id\")\n",
    ")\n",
    "\n",
    "\n",
    "sample_user_id = next(\n",
    "    iter(users_by_id)\n",
    ")\n",
    "\n",
    "sample_user = users_by_id[\n",
    "    sample_user_id\n",
    "]\n",
    "\n",
    "print(\n",
    "    \"\\nSample user ID:\",\n",
    "    sample_user_id\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Sample user keys:\",\n",
    "    list(sample_user.keys())\n",
    ")\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Select real order + owner\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "ATTACK_ORDER_ID = None\n",
    "ATTACK_OWNER_ID = None\n",
    "ATTACK_OWNER_EMAIL = None\n",
    "\n",
    "\n",
    "for order_id, order in orders_by_id.items():\n",
    "\n",
    "    owner_id = owner_id_for_order(\n",
    "        order_id\n",
    "    )\n",
    "\n",
    "    if owner_id is None:\n",
    "        continue\n",
    "\n",
    "    owner_email = email_for_user(\n",
    "        owner_id\n",
    "    )\n",
    "\n",
    "    if owner_email:\n",
    "\n",
    "        ATTACK_ORDER_ID = order_id\n",
    "        ATTACK_OWNER_ID = owner_id\n",
    "        ATTACK_OWNER_EMAIL = owner_email\n",
    "\n",
    "        break\n",
    "\n",
    "\n",
    "assert ATTACK_ORDER_ID is not None, (\n",
    "    \"Could not find an order with a valid linked user.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Choose another customer as attacker\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "ATTACK_WRONG_ID = None\n",
    "ATTACK_WRONG_EMAIL = None\n",
    "\n",
    "\n",
    "for user_id, user in users_by_id.items():\n",
    "\n",
    "    email = user.get(\n",
    "        \"email\"\n",
    "    )\n",
    "\n",
    "    if (\n",
    "        str(user_id) != str(ATTACK_OWNER_ID)\n",
    "        and email\n",
    "    ):\n",
    "\n",
    "        ATTACK_WRONG_ID = user_id\n",
    "        ATTACK_WRONG_EMAIL = email\n",
    "\n",
    "        break\n",
    "\n",
    "\n",
    "assert ATTACK_WRONG_EMAIL is not None\n",
    "\n",
    "\n",
    "attack_order = orders_by_id[\n",
    "    ATTACK_ORDER_ID\n",
    "]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n✅ Security fixtures selected\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Attack order:\",\n",
    "    ATTACK_ORDER_ID\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Real owner ID:\",\n",
    "    ATTACK_OWNER_ID\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Real owner:\",\n",
    "    ATTACK_OWNER_EMAIL\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Wrong user:\",\n",
    "    ATTACK_WRONG_EMAIL\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Order status:\",\n",
    "    attack_order.get(\"status\")\n",
    ")"
