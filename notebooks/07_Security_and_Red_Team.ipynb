    "TAU_DIR = Path(\"/content/tau2-bench\") if \"google.colab\" in sys.modules else Path(\"tau2-bench\")\n",
    "\n",
    "if not TAU_DIR.exists():\n",
    "    subprocess.run(\n",
    "        [\n",
    "            \"git\",\n",
    "            \"clone\",\n",
    "            \"-q\",\n",
    "            \"https://github.com/sierra-research/tau2-bench.git\",\n",
    "            str(TAU_DIR)\n",
    "        ],\n",
    "        check=True\n",
