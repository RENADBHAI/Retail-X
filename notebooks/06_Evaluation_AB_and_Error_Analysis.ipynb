  },
  {
   "cell_type": "code",
   "source": [
    "from google.colab import userdata\n",
    "from openai import OpenAI\n",
    "\n",
    "OPENROUTER_API_KEY = userdata.get(\n",
    "    \"OPENROUTER_API_KEY\"\n",
    ")\n",
    "\n",
    "assert OPENROUTER_API_KEY, \"Add OPENROUTER_API_KEY to Colab Secrets first.\"\n",
    "\n",
    "client = OpenAI(\n",
    "    base_url=\"https://openrouter.ai/api/v1\",\n",
    "    api_key=OPENROUTER_API_KEY\n",
    ")\n",
    "\n",
    "# Fixed model for BOTH A and B so the comparison is fair.\n",
    "MODEL = \"google/gemini-2.5-flash-lite\"\n",
    "\n",
    "MAX_STEPS = 8\n",
    "MAX_OUTPUT_TOKENS = 300\n",
    "\n",
    "print(\" OpenRouter client ready\")\n",
    "print(\"MODEL:\", MODEL)\n",
    "print(\"MAX_OUTPUT_TOKENS:\", MAX_OUTPUT_TOKENS)\n"
   ],
   "metadata": {
    "id": "T1gCtS4CUgHc"
   },
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": [
    "import json\n",
    "import time\n",
    "from openai import APIStatusError\n",
    "\n",
    "# OpenRouter free/low-cost routes can enforce per-minute request limits.\n",
    "# This spaces EVERY model request, including multi-step tool calls.\n",
    "MIN_SECONDS_BETWEEN_REQUESTS = 3.2\n",
    "_last_model_request_at = 0.0\n",
    "\n",
    "\n",
    "def _throttle_model_request():\n",
    "    global _last_model_request_at\n",
    "\n",
    "    elapsed = time.monotonic() - _last_model_request_at\n",
    "    wait_for = MIN_SECONDS_BETWEEN_REQUESTS - elapsed\n",
    "\n",
    "    if wait_for > 0:\n",
    "        time.sleep(wait_for)\n",
    "\n",
    "    _last_model_request_at = time.monotonic()\n",
    "\n",
    "\n",
    "def run_eval_agent(\n",
    "    user_request,\n",
    "    system_prompt\n",
    "):\n",
    "\n",
    "    messages = [\n",
    "        {\n",
    "            \"role\": \"system\",\n",
    "            \"content\": system_prompt\n",
    "        },\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": user_request\n",
    "        }\n",
    "    ]\n",
    "\n",
    "    trace = []\n",
    "    total_input_tokens = 0\n",
    "    total_output_tokens = 0\n",
    "    requests = 0\n",
    "\n",
    "    for step in range(1, MAX_STEPS + 1):\n",
    "\n",
    "        response = None\n",
    "\n",
    "        for attempt in range(4):\n",
    "\n",
    "            try:\n",
    "                _throttle_model_request()\n",
    "\n",
    "                response = client.chat.completions.create(\n",
    "                    model=MODEL,\n",
    "                    messages=messages,\n",
    "                    tools=TOOLS,\n",
    "                    tool_choice=\"auto\",\n",
    "                    parallel_tool_calls=False,\n",
    "                    max_tokens=MAX_OUTPUT_TOKENS,\n",
    "                    temperature=0\n",
    "                )\n",
    "\n",
    "                break\n",
    "\n",
    "            except APIStatusError as e:\n",
    "\n",
    "                error_text = str(e).lower()\n",
    "\n",
    "                # Temporary OpenRouter in-flight budget pressure.\n",
    "                if (\n",
    "                    e.status_code == 402\n",
    "                    and \"in_flight\" in error_text\n",
    "                    and attempt < 3\n",
    "                ):\n",
    "                    wait_seconds = 15\n",
    "                    print(\n",
    "                        f\"↻ OpenRouter in-flight limit — \"\n",
    "                        f\"retry {attempt + 1}/3 in {wait_seconds}s\"\n",
    "                    )\n",
    "                    time.sleep(wait_seconds)\n",
    "                    continue\n",
    "\n",
    "                # Temporary per-minute rate limit.\n",
    "                if (\n",
    "                    e.status_code == 429\n",
    "                    and attempt < 3\n",
    "                ):\n",
    "                    wait_seconds = 20\n",
    "                    print(\n",
    "                        f\"↻ OpenRouter rate limit — \"\n",
    "                        f\"retry {attempt + 1}/3 in {wait_seconds}s\"\n",
    "                    )\n",
    "                    time.sleep(wait_seconds)\n",
    "                    continue\n",
    "\n",
    "                raise\n",
    "\n",
    "        if response is None:\n",
    "            raise RuntimeError(\n",
    "                \"No response received from OpenRouter.\"\n",
    "            )\n",
    "\n",
    "        requests += 1\n",
    "\n",
    "        if response.usage:\n",
    "            total_input_tokens += (\n",
    "                response.usage.prompt_tokens or 0\n",
    "            )\n",
    "            total_output_tokens += (\n",
    "                response.usage.completion_tokens or 0\n",
    "            )\n",
    "\n",
    "        message = response.choices[0].message\n",
    "        messages.append(message)\n",
    "\n",
    "        # Final answer\n",
    "        if not message.tool_calls:\n",
    "            return {\n",
    "                \"answer\": message.content or \"\",\n",
    "                \"trace\": trace,\n",
    "                \"steps\": step,\n",
    "                \"requests\": requests,\n",
    "                \"input_tokens\": total_input_tokens,\n",
    "                \"output_tokens\": total_output_tokens,\n",
    "                \"stopped\": \"done\"\n",
    "            }\n",
    "\n",
    "        # Tool execution\n",
    "        for call in message.tool_calls:\n",
    "\n",
    "            name = call.function.name\n",
    "\n",
    "            try:\n",
    "                arguments = json.loads(\n",
    "                    call.function.arguments or \"{}\"\n",
    "                )\n",
    "            except Exception:\n",
    "                arguments = {}\n",
    "\n",
    "            result = execute_tool(\n",
    "                name,\n",
    "                arguments\n",
    "            )\n",
    "\n",
    "            trace.append({\n",
    "                \"step\": step,\n",
    "                \"tool\": name,\n",
    "                \"arguments\": arguments,\n",
    "                \"result\": result\n",
    "            })\n",
    "\n",
    "            messages.append({\n",
    "                \"role\": \"tool\",\n",
    "                \"tool_call_id\": call.id,\n",
    "                \"content\": json.dumps(\n",
    "                    result,\n",
    "                    ensure_ascii=False,\n",
    "                    default=str\n",
    "                )\n",
    "            })\n",
    "\n",
    "    return {\n",
    "        \"answer\": \"\",\n",
    "        \"trace\": trace,\n",
    "        \"steps\": MAX_STEPS,\n",
